# --- Vision ---------------------------------------------------------------
# auto  = CLIP zero-shot if torch+transformers are installed, else classical OpenCV
# clip | heuristic to force one
VISION_BACKEND=auto
CLIP_MODEL=openai/clip-vit-base-patch32

# --- LLM ------------------------------------------------------------------
# auto = anthropic if ANTHROPIC_API_KEY is set, else openai-compatible if OPENAI_BASE_URL is set, else offline rules
# anthropic | openai | rules to force one
LLM_PROVIDER=auto

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible endpoint (keep keys on the server, never in the frontend):
#   Ollama (local, free):  http://localhost:11434/v1   model e.g. llama3.1
#   Gemini free tier:      https://generativelanguage.googleapis.com/v1beta/openai   model e.g. gemini-2.0-flash
#   Groq:                  https://api.groq.com/openai/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1

# --- Gemini (right-item check and blind damage check) ---------------------
# Free key: https://aistudio.google.com/apikey . Without it, defect claims go to a reviewer.
GEMINI_API_KEY=
VLM_MODEL=gemini-3.5-flash-lite
VLM_FALLBACK_MODEL=gemini-2.5-flash

# --- Business rules (defaults shown) ---------------------------------------
# RETURN_WINDOW_DAYS=10
# AUTO_APPROVE_MAX_PRICE=5000
# AUTO_REJECT_OUTSIDE_WINDOW=1

# --- Demo ------------------------------------------------------------------
# Shows test accounts and the reset button on the login page. Set to 0 for any public deployment.
SHOW_DEMO_ACCOUNTS=1
